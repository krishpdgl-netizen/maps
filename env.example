# The Web App URL you get after deploying AppsScript-Code.gs
# (Deploy -> New deployment -> Web app -> copy the URL it gives you)
APPS_SCRIPT_URL=https://script.google.com/macros/s/your-deployment-id/exec

# Must match the SHARED_SECRET value you set inside AppsScript-Code.gs
APPS_SCRIPT_SECRET=your-random-secret-here

# Any long random string — used to sign login session cookies
JWT_SECRET=replace-with-a-long-random-string

# Google Maps JavaScript API key, from Google Cloud Console
# (Maps JavaScript API + Directions API both need to be enabled)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
